# Run python setup.py to validate your own BotFather token and create .env.
TELEGRAM_BOT_TOKEN=
PAIRING_CODE=
# Limit subscriptions per exchange for a laptop. 0 = all spot USDT pairs (heavy).
MAX_SYMBOLS_PER_EXCHANGE=40
# Optional explicit subset, e.g. BTC/USDT,ETH/USDT,SOL/USDT
SYMBOLS=
# Market data only: no exchange API keys are accepted or required.
EXCHANGES=kucoin,gate,bitget,mexc,bybit,bingx,htx,coinex,bitmart,okx
